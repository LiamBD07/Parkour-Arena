# Optional locally: without this URL, development uses .data/postgres.
# Required in production. Copy the pooled PostgreSQL URL from Neon, keeping sslmode=require.
DATABASE_URL=
# Optional direct connection for migrations, supplied by neon deploy / neon env pull.
DATABASE_URL_UNPOOLED=
# Optional managed Better Auth migration; leave both unset for the app's existing email/password login.
# Both are supplied by neon deploy when auth:true is enabled.
# The server publishes only the Auth base URL to the browser; JWT verification stays server-side.
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
# Optional override for a custom domain. Render's assigned URL is detected automatically.
APP_ORIGIN=http://localhost:3000
PORT=3000
# Optional real-money shop. Set the key, webhook secret and all three Prices to enable checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_1000=
STRIPE_PRICE_2800=
STRIPE_PRICE_6500=
# Optional WebRTC STUN server. TURN credentials are never embedded in the client.
STUN_URL=stun:stun.l.google.com:19302
